# Porta do servidor (apenas para rodar localmente com `npm run dev`)
PORT=3000

# Banco de dados: NÃO precisa configurar nada aqui. O Netlify provisiona um
# Postgres automaticamente (Netlify DB) e injeta a variável NETLIFY_DB_URL
# sozinho, tanto em produção quanto ao rodar `netlify dev` localmente.

# Segredo usado para assinar o cookie de sessao (gere uma string aleatoria longa)
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Credenciais do administrador criadas pelo comando "npm run setup:admin"
ADMIN_EMAIL=contato@techwave.tec.br
ADMIN_PASSWORD=troque-esta-senha

# --- Envio de e-mail (SMTP) ---
# Funciona com Gmail/Google Workspace, Outlook/Microsoft 365, SendGrid, Amazon SES, Zoho, etc.
# Exemplo Gmail/Workspace: host smtp.gmail.com, porta 465, secure true, use uma "Senha de App"
# Exemplo Outlook/365:     host smtp.office365.com, porta 587, secure false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@techwave.tec.br
SMTP_PASS=sua-senha-de-app

# Nome e e-mail que aparecem como remetente
MAIL_FROM_NAME=Techwave IT Solutions
MAIL_FROM_EMAIL=contato@techwave.tec.br

# Copia oculta opcional de todo relatorio enviado (auditoria interna)
MAIL_BCC=

# URL do site institucional, usada no rodape dos relatorios/e-mails
COMPANY_SITE_URL=https://www.techwave.tec.br
COMPANY_PHONE=(22) 99746-7783
